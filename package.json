{
  "name": "todo-app",
  "version": "1.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && tsc-alias",
    "test": "vitest run",
    "test:watch": "vitest",

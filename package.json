    "@vitest/coverage-v8": "^1.6.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
